local aberto = false

local function abrirPainel()
    if aberto then return end
    aberto = true
    spinning = true
    painel.Visible = true
    painel.Position = UDim2.new(1, 290, 0, 90)
    painel.BackgroundTransparency = 1
    TweenService:Create(painel, TweenInfo.new(1.1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -260, 0, 90),
        BackgroundTransparency = 0
    }):Play()
    task.delay(1.6, function() spinning = false end)
end

local function fecharPainel()
    if not aberto then return end
    aberto = false
    spinning = true
    TweenService:Create(painel, TweenInfo.new(0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
        Position = UDim2.new(1, 290, 0, 90),
        BackgroundTransparency = 1
    }):Play()
    task.delay(0.9, function()
        painel.Visible = false
        spinning = false
    end)
end

botao.MouseButton1Click:Connect(function()
