local dragging, dragInput, dragStart, startPos
topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = painel.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        painel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local autoLigado = false
local posicaoSalva = nil
local loopThread = nil
local jaTeleportados = setmetatable({}, {__mode = "k"})

local function atualizarStatus()
    if posicaoSalva then
        status.Text = string.format(
            "✅  DESTINATION SAVED\n\nX: %.0f\nY: %.0f\nZ: %.0f",
            posicaoSalva.X, posicaoSalva.Y, posicaoSalva.Z
        )
        status.TextColor3 = Color3.fromRGB(130, 230, 130)
    else
        status.Text = "⚠  No position saved yet.\n\nPress 'Save Current Position' first."
        status.TextColor3 = COR_SUB
    end
end

local function ehLog(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("BasePart") then return false end
    if obj.Anchored then return false end
    local nome = string.lower(obj.Name)
    return nome:find("log") ~= nil
end

local function teleportarLog(log)
    pcall(function() log:SetNetworkOwner(player) end)
    pcall(function() log.CFrame = CFrame.new(posicaoSalva) end)
    pcall(function()
        log.AssemblyLinearVelocity = Vector3.zero
        log.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function iniciarLoop()
    if loopThread then return end
    loopThread = task.spawn(function()
        while autoLigado do
            if posicaoSalva then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if not autoLigado then break end
                    if ehLog(obj) and not jaTeleportados[obj] then
                        jaTeleportados[obj] = true
                        teleportarLog(obj)
                    end
                end
            end
            task.wait(0.25)
        end
        loopThread = nil
    end)
end

local function pararLoop()
    autoLigado = false
    loopThread = nil
end

salvar.MouseButton1Click:Connect(function()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    posicaoSalva = root.Position
    atualizarStatus()
    salvar.Text = "✅  Position Saved!"
    TweenService:Create(salvar, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(50, 160, 80)}):Play()
    task.wait(1.2)
    salvar.Text = "📍  Save Current Position"
    TweenService:Create(salvar, TweenInfo.new(0.3), {BackgroundColor3 = COR_PANEL}):Play()
end)

auto.MouseButton1Click:Connect(function()
    if not posicaoSalva then
        status.Text = "❌  Save a position first!"
        status.TextColor3 = Color3.fromRGB(230, 80, 80)
        return
    end
    autoLigado = not autoLigado
    if autoLigado then
        auto.Text = "🪵  Auto Wood: ON"
        TweenService:Create(auto, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 160, 80)}):Play()
        jaTeleportados = setmetatable({}, {__mode = "k"})
        iniciarLoop()
    else
        auto.Text = "🪵  Auto Wood: OFF"
        TweenService:Create(auto, TweenInfo.new(0.2), {BackgroundColor3 = COR_PANEL}):Play()
        pararLoop()
    end
end)

